PORT=5000
CLIENT_URL=http://localhost:3000

# 로컬 개발: npm run dev → MONGODB_URI (shopping-mall) 사용
MONGODB_URI=mongodb://127.0.0.1:27017/shopping-mall
# 운영(Cloudtype, NODE_ENV=production)에서만 이 값을 우선 사용
MONGODB_ATLAS_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DB_NAME

# JWT (로그인 토큰)
# JWT_SECRET: 토큰 서명/검증용 비밀키 (배포 시 반드시 복잡한 값으로 변경)
# JWT_EXPIRES_IN: 토큰 유효 기간 (예: 7d, 24h, 60m)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 포트원(아임포트) REST API — 결제 검증용
# 콘솔: 결제 연동 → 연동 정보 → API Keys
PORTONE_API_KEY=
PORTONE_API_SECRET=
